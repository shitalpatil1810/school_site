# Postgres connection string (Neon, Supabase, or local docker postgres)
DATABASE_URI=postgresql://user:password@localhost:5432/school_site

# Long random string — generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public site URL (used by Payload for links / CORS)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
