{
  "name": "school-site",
  "version": "0.1.0",
  "description": "School website built with Next.js + Payload CMS 3 + PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "payload generate:types && payload generate:importmap && next build",
    "start": "next start",
    "generate:types": "payload generate:types",
    "payload": "payload",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen http://localhost:3000",
    "test:e2e:report": "playwright show-report tests/playwright-report"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "latest",
    "@payloadcms/next": "latest",
    "@payloadcms/richtext-lexical": "latest",
    "@payloadcms/storage-s3": "^3.85.1",
    "lexical": "0.41.0",
    "next": "^16",
    "payload": "latest",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.33",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^5"
  },
  "engines": {
    "node": "^20 || ^22"
  }
}
