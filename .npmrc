# Hoist all Lexical packages to the project root so every import resolves to
# the same module instance. Without this, pnpm's strict isolation lets
# Turbopack see the same file through different symlink paths and create two
# separate module identities for HorizontalRuleNode / HorizontalRuleServerNode,
# both claiming type "horizontalrule" — causing the "does not match registered
# node" error in the admin's Lexical editor.
public-hoist-pattern[]=lexical
public-hoist-pattern[]=@lexical/*
# Also hoist the bare "lexical" package (no @ scope)
shamefully-hoist-workspace-packages=false
